from PIL import Image, ImageDraw, ImageFont

# Orijinal görselin yolunu buraya yaz
input_path = "kart_moodu_orijinal.jpg"  # senin yüklediğin kart
output_path = "kart_moodu_sticker.png"

# Görseli aç ve kareye kırp
img = Image.open(input_path)

# Sticker boyutu
size = (512, 512)
img = img.resize(size, Image.LANCZOS)

# Çizim başlat
draw = ImageDraw.Draw(img)

# Türkçe karakter destekleyen font
try:
    font_title = ImageFont.truetype("DejaVuSans-Bold.ttf", 32)
    font_text = ImageFont.truetype("DejaVuSans.ttf", 22)
    font_stats = ImageFont.truetype("DejaVuSans-Bold.ttf", 26)
except:
    font_title = ImageFont.load_default()
    font_text = ImageFont.load_default()
    font_stats = ImageFont.load_default()

# Başlık
draw.text((size[0]//2, 18), "KART MOODU", font=font_title, fill="white", anchor="ma")

# Açıklama kutusu (orijinal yazıların üstüne yeni metin)
desc = ("Bu özel büyü, kartı attığınız kişinin gay olduğunu unutturur. "
        "Kartı gönderdiğiniz kişi önceden gay olduğunu hatırlamayacaktır.")
draw.rectangle([20, 330, 492, 470], fill=(240, 240, 210))  # açık kutu
draw.multiline_text((30, 340), desc, font=font_text, fill="black", spacing=4)

# ATK / DEF
draw.text((30, 480), "ATK / 99", font=font_stats, fill="black")
draw.text((360, 480), "DEF / 90", font=font_stats, fill="black")

# Kaydet
img.save(output_path)
print(f"Sticker hazır: {output_path}")
